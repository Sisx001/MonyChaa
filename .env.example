# ============ REQUIRED ============
TELEGRAM_BOT_TOKEN=123456:ABCdef
GEMINI_API_KEY=AIza...
OWNER_USER_ID=6540382154
OWNER_TIMEZONE=Asia/Singapore
PORT=3000
# Set to require a login on the admin panel (recommended when exposing port 3000)
ADMIN_PASSWORD=
ADMIN_USER=admin
# Set to 1 ONLY when running behind a reverse proxy (nginx/caddy) — trusts
# X-Forwarded-For for client IP. Leave unset if the port is exposed directly.
TRUST_PROXY=
# Set to 1 when serving over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=

# ============ OPTIONAL LLM PROVIDERS ============
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
